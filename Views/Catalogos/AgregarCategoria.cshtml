@model Categoria

@using (Html.BeginForm("AgregarCategoria", "Catalogos", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="modal-body">
        <div class="mb-2">
            @Html.LabelFor(m => m.cat_nombre, "Nombre", new { @class = "form-label text-dark fw-semibold" })
            <div class="input-group">
                @Html.TextBoxFor(m => m.cat_nombre, new { @class = "form-control", required = "required" })
                <span class="input-group-text"><i class="bi bi-tag"></i></span>
            </div>
        </div>
        <div class="row g-2">
            <div class="col">
                @Html.LabelFor(m => m.cat_descripcion, "Descripción", new { @class = "form-label text-dark fw-semibold" })
                <div class="input-group">
                    @Html.TextAreaFor(m => m.cat_descripcion, new { @class = "form-control", rows = 3 })
                </div>
            </div>
            <div class="col">
                @Html.LabelFor(m => m.cat_activo!.act_id, "Estado", new { @class = "form-label text-dark fw-semibold" })
                @Html.DropDownListFor(m => m.cat_activo!.act_id, (SelectList)ViewBag.Estados, "Seleccione", new { @class = "form-select", required = "required" })
            </div>
        </div>
        <div class="mb-2 mt-2">
            <label class="form-label text-dark fw-semibold">Imagen de la categoría  </label>
            <div id="zonaImagen" class="zona-imagen text-center p-4">
                <i id="iconoImagen" class="bi bi-image fs-1 text-secondary"></i>
                <img id="vistaPrevia" class="d-none mx-auto" alt="Vista previa" />
                <p class="fw-semibold mb-0 mt-2">Arrastra una imagen aquí</p>
                <small class="text-muted">o haz clic para seleccionar</small>
                <div class="mt-2">
                    <span class="btn btn-outline-success btn-sm">
                        <i class="bi bi-folder2-open me-1"></i>Seleccionar archivo
                    </span>
                </div>
            </div>
            <input type="file" name="imagen" id="inputImagen" accept=".jpg,.jpeg,.png,.webp" class="d-none" />
        </div>
    </div>
    <div class="modal-footer border-0">
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-success">Guardar</button>
    </div>
}


<script>
    const zona = document.getElementById('zonaImagen');
    const input = document.getElementById('inputImagen');
    const vista = document.getElementById('vistaPrevia');
    const icono = document.getElementById('iconoImagen');

    function mostrar(archivo) {
        if (!archivo || !archivo.type.startsWith('image/')) return;
        vista.src = URL.createObjectURL(archivo);
        vista.classList.remove('d-none');
        icono.classList.add('d-none');
    }

    zona.addEventListener('click', () => input.click());
    input.addEventListener('change', () => mostrar(input.files[0]));

    ['dragenter', 'dragover'].forEach(e =>
        zona.addEventListener(e, ev => { ev.preventDefault(); zona.classList.add('arrastrando'); }));
    ['dragleave', 'drop'].forEach(e =>
        zona.addEventListener(e, ev => { ev.preventDefault(); zona.classList.remove('arrastrando'); }));

    zona.addEventListener('drop', ev => {
        input.files = ev.dataTransfer.files;
        mostrar(input.files[0]);
    });
</script>