@model List<Inventario.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
    </div>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Panel", "Home")" class="text-success text-decoration-none">
                <i class="bi bi-house-fill me-1"></i>Inicio
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Catalogos</li>
    </ol>
</nav>  

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <img src="/Images/cubo_verde.png" alt="Productos" style="height:60px" />
        <div>
            <h1 class="fw-bold mb-0">Categorias</h1>
            <p class="text-muted mb-0">Consulta, administra y mantén actualizado el catálogo de categorias.</p>
        </div>
    </div>
    @using (Html.BeginForm("Crear", "Categoria", FormMethod.Get, new { @class = "m-0" }))
    {
        <button type="button" class="btn-agregar" data-bs-toggle="modal" data-bs-target="#modalCategoria">
            <span class="btn-agregar-icono"><i class="bi bi-plus-lg"></i></span>
            Agregar categoria
        </button>
    }
</div>

@using (Html.BeginForm("categorias", "Catalogos", FormMethod.Get, new { @class = "card card-body mb-4" }))
{
    <div class="row g-3 align-items-end">
        <div class="col-md-10">
            <div class="input-group">
                @Html.TextBox("buscar", (string)ViewBag.Buscar, new { @class = "form-control", placeholder = "Buscar por nombre, código o marca..." })
                <button class="btn btn-success"><i class="bi bi-search me-1"></i>Buscar</button>
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label form-label text-dark fw-semibold">Estado</label>
            @Html.DropDownList("estado", (SelectList)ViewBag.Estados, new { @class = "form-select", onchange = "this.form.submit()" })
        </div>
    </div>
}

<div class="card">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-success">
            <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Imagen</th>
                <th scope="col">Descripcion</th>
                <th scope="col">Estado</th>
                <th scope="col" class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.cat_nombre</td>
                    <td>
                        <img src="/Images/catalogos/@c.cat_imagen" alt="@c.cat_nombre" style="height:50px" />
                    </td>
                    <td>@c.cat_descripcion</td>
                    <td>
                        <span class="badge rounded-pill @(c.cat_activo?.act_nombre == "Inactivo" ? "text-bg-danger" : "text-bg-success")">
                            @c.cat_activo?.act_nombre
                        </span>
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-primary me-1" onclick="abrirModificar(@c.cat_id)">
                            <i class="bi bi-pencil-fill"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="confirmarEliminar(@c.cat_id, '@c.cat_nombre')">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalCategoria" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white justify-content-center">
                <h5 class="modal-title">Agregar categoria</h5>
            </div>
            @await Html.PartialAsync("AgregarCategoria", new Inventario.Models.Categoria())
        </div>
    </div>
</div>

<div class="modal fade" id="ModificarCategoria" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white justify-content-center">
                <h5 class="modal-title">Actualizar categoría</h5>
            </div>
            <div id="contenidoModificar"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white justify-content-center">
                <h5 class="modal-title">Eliminar Categoria</h5>
            </div>
            @using (Html.BeginForm("EliminarCategoria", "Catalogos", FormMethod.Post))
            {
                <input type="hidden" name="id" id="idEliminar" />
                <div class="modal-body text-center">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                    <p class="mt-2 mb-0">¿Seguro que quieres eliminar a <strong id = "nombreEliminar"></strong></p>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function abrirModificar(id) {
        const r = await fetch('@Url.Action("ModificarCategoria", "Catalogos")?id=' + id);
        document.getElementById('contenidoModificar').innerHTML = await r.text();
        new bootstrap.Modal(document.getElementById('ModificarCategoria')).show();
    }

    function previsualizarMod(input) {
        if (!input.files[0]) return;
        const v = document.getElementById('vistaPreviaMod');
        v.src = URL.createObjectURL(input.files[0]);
        v.classList.remove('d-none');
        document.getElementById('iconoMod')?.classList.add('d-none');
    }

       function confirmarEliminar(id, nombre) {
        document.getElementById('idEliminar').value = id;
        document.getElementById('nombreEliminar').textContent = nombre;
        new bootstrap.Modal(document.getElementById('modalEliminar')).show();
    }

    setTimeout(() => document.querySelectorAll('.alert').forEach(a =>
    bootstrap.Alert.getOrCreateInstance(a).close()), 4000);
</script>
}