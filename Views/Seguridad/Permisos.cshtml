@model List<Inventario.Models.Rol>

@{
    ViewData["Title"] = "Roles y Permisos";
    var rolActual = ViewBag.RolActual as Inventario.Models.Rol;
    var permisos = ViewBag.Permisos as List<Inventario.Models.MenuPermisoVM> ?? new();
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
    </div>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Panel", "Home")" class="text-success text-decoration-none">
                <i class="bi bi-house-fill me-1"></i>Inicio
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Seguridad</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-success">
    <div class="d-flex align-items-center gap-3">
        <i class="bi bi-shield-lock-fill text-success" style="font-size: 2.5rem;"></i>
        <div>
            <h1 class="fw-bold mb-0 titulo-catalogo">Roles y permisos</h1>
            <p class="text-muted mb-0">Administra los roles del sistema y sus permisos de acceso.</p>
        </div>
    </div>
    @using (Html.BeginForm("Crear", "Seguridad", FormMethod.Get, new { @class = "m-0" }))
    {
        <button type="button" class="btn-agregar" data-bs-toggle="modal" data-bs-target="#modalRol">
            <span class="btn-agregar-icono"><i class="bi bi-plus-lg"></i></span>
            Agregar Rol
        </button>
    }
</div>

<div class="roles-grid">

    <div class="card panel-verde">
        <div class="panel-verde-header">
            <span class="fw-bold fs-5"><i class="bi bi-people-fill me-2"></i>Roles</span>
        </div>
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 12%;">Rol</th>
                    <th style="width: 50%;">Descripción</th>
                    <th style="width: 15%;">Estado</th>
                    <th class="text-center" style="width: 15%;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="fila-rol @(rolActual?.rol_id == r.rol_id ? "table-success" : "")"
                        data-url="@Url.Action("Permisos", "Seguridad", new { rolId = r.rol_id })">
                        <td class="fw-semibold">@r.rol_nombre</td>
                        <td class="text-start ps-5">@r.rol_descripcion</td>
                        <td>
                            <span class="badge rounded-pill @(r.rol_activo?.act_nombre == "Inactivo" ? "text-bg-danger" : "text-bg-success")">
                                @r.rol_activo?.act_nombre
                            </span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-primary me-1" onclick="abrirModificar(@r.rol_id)">
                                <i class="bi bi-pencil-fill"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-danger"
                                    data-id="@r.rol_id" data-nombre="@r.rol_nombre"
                                    onclick="confirmarEliminar(this)">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card panel-verde">
        <div class="panel-verde-header">
            <span class="fw-bold fs-5">
                <i class="bi bi-shield-check me-2"></i>Permisos del rol:
                <span class="rol-seleccionado">@rolActual?.rol_nombre</span>
            </span>
        </div>

        @if (rolActual == null)
        {
            <div class="p-4 text-center text-muted">Selecciona un rol para ver sus permisos.</div>
        }
        else
        {
            @using (Html.BeginForm("GuardarPermisos", "Seguridad", FormMethod.Post))
            {
                @Html.Hidden("rolId", rolActual.rol_id)

                <div class="p-3">
                @foreach (var m in permisos)
                {
                    <div class="grupo-menu">
                        <div class="d-flex align-items-center">
                            @if (m.Hijos.Any())
                            {
                                <button type="button" class="btn btn-sm p-0 me-2" data-bs-toggle="collapse" data-bs-target="#grupo-@m.Id">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            }
                            else
                            {
                                <span class="me-4"></span>
                            }
                            <input type="checkbox" class="form-check-input check-padre" name="menus" value="@m.Id" checked="@m.Marcado" />
                            <i class="bi @m.Icono mx-2"></i>
                            <span class="fw-semibold">@m.Nombre</span>
                        </div>

                        @if (m.Hijos.Any())
                        {
                            <div class="collapse show ps-5 pt-1" id="grupo-@m.Id">
                                @foreach (var h in m.Hijos)
                                {
                                    <div class="py-1">
                                        <input type="checkbox" class="form-check-input check-hijo" name="menus" value="@h.Id" checked="@h.Marcado" />
                                        <span class="ms-2">@h.Nombre</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                </div>

                <div class="p-3 text-end border-top">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-floppy me-1"></i>Guardar cambios
                    </button>
                </div>
            }
        }
    </div>
</div>

<div class="modal fade" id="modalRol" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white justify-content-center">
                <h5 class="modal-title">Agregar Rol</h5>
            </div>
            @await Html.PartialAsync("AgregarRol", new Inventario.Models.Rol())
        </div>
    </div>
</div>

<div class="modal fade" id="ModificarRol" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white justify-content-center">
                <h5 class="modal-title">Actualizar Rol</h5>
            </div>
            <div id="contenidoModificar"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white justify-content-center">
                <h5 class="modal-title">Eliminar Usuario</h5>
            </div>
            @using (Html.BeginForm("EliminarRol", "Seguridad", FormMethod.Post))
            {
                <input type="hidden" name="id" id="idEliminar" />
                <div class="modal-body text-center">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                    <p class="mt-2 mb-0">¿Seguro que quieres eliminar a <strong id = "nombreEliminar"></strong></p>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function abrirModificar(id) {
        const r = await fetch('@Url.Action("ModificarRol", "Seguridad")?id=' + id);
        document.getElementById('contenidoModificar').innerHTML = await r.text();
        new bootstrap.Modal(document.getElementById('ModificarRol')).show();
    }

    setTimeout(() => document.querySelectorAll('.alert').forEach(a =>
    bootstrap.Alert.getOrCreateInstance(a).close()), 4000);

    function confirmarEliminar(boton) {
        document.getElementById('idEliminar').value = boton.dataset.id;
        document.getElementById('nombreEliminar').textContent = boton.dataset.nombre;
        new bootstrap.Modal(document.getElementById('modalEliminar')).show();
    }
        
    document.querySelectorAll('.check-padre').forEach(p =>
        p.addEventListener('change', () =>
            p.closest('.grupo-menu').querySelectorAll('.check-hijo').forEach(h => h.checked = p.checked)));

    document.querySelectorAll('.fila-rol').forEach(f =>
    f.addEventListener('click', e => {
        if (e.target.closest('button')) return;
        window.location = f.dataset.url;
    }));

    document.querySelectorAll('.check-padre').forEach(p =>
        p.addEventListener('change', () =>
            p.closest('.grupo-menu').querySelectorAll('.check-hijo').forEach(h => h.checked = p.checked)));

    document.querySelectorAll('.check-hijo').forEach(h =>
        h.addEventListener('change', () => {
            const grupo = h.closest('.grupo-menu');
            grupo.querySelector('.check-padre').checked =
                grupo.querySelectorAll('.check-hijo:checked').length > 0;
        }));
</script>
}