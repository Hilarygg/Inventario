@model List<Inventario.Models.MenuItemVM>

<ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-4">
@foreach (var item in Model)
{
    if (item.Hijos.Any())
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi @item.Icono"></i> @item.Nombre
            </a>
            <ul class="dropdown-menu">
                @foreach (var hijo in item.Hijos)
                {
                    <li>
                        <a class="dropdown-item" href="@hijo.Ruta">
                            <i class="bi @hijo.Icono"></i> @hijo.Nombre
                        </a>
                    </li>
                }
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" href="@item.Ruta">
                <i class="bi @item.Icono"></i> @item.Nombre
            </a>
        </li>
    }
}
</ul>