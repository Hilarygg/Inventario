@model List<Inventario.Models.Producto>

@{ ViewData["Title"] = "Productos"; }

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
    </div>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Panel", "Home")" class="text-success text-decoration-none">
                <i class="bi bi-house-fill me-1"></i>Inicio
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Productos</li>
    </ol>
</nav>  

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <img src="/Images/cubo_verde.png" alt="Productos" style="height:60px" />
        <div>
            <h1 class="fw-bold mb-0">Lista de Productos</h1>
            <p class="text-muted mb-0">Consulta, administra y mantén actualizado el catálogo de productos.</p>
        </div>
    </div>
    @using (Html.BeginForm("Crear", "Producto", FormMethod.Get, new { @class = "m-0" }))
    {
        <button type="button" class="btn-agregar" data-bs-toggle="modal" data-bs-target="#modalProducto">
            <span class="btn-agregar-icono"><i class="bi bi-plus-lg"></i></span>
            Agregar producto
        </button>
    }
</div>

@using (Html.BeginForm("Index", "Producto", FormMethod.Get, new { @class = "card card-body mb-4" }))
{
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <div class="input-group">
                @Html.TextBox("buscar", (string)ViewBag.Buscar, new { @class = "form-control", placeholder = "Buscar por nombre, código o marca..." })
                <button class="btn btn-success"><i class="bi bi-search me-1"></i>Buscar</button>
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label text-dark fw-semibold">Categoría</label>
            @Html.DropDownList("categoria", (SelectList)ViewBag.Categorias, "Todas", new { @class = "form-select", onchange = "this.form.submit()" })
        </div>
        <div class="col-md-2">
            <label class="form-label form-label text-dark fw-semibold">Marca</label>
            @Html.DropDownList("marca", (SelectList)ViewBag.Marcas, "Todas", new { @class = "form-select", onchange = "this.form.submit()" })
        </div>
        <div class="col-md-2">
            <label class="form-label form-label text-dark fw-semibold">Estado</label>
            @Html.DropDownList("estado", (SelectList)ViewBag.Estados, new { @class = "form-select", onchange = "this.form.submit()" })
        </div>
    </div>
}

<div class="card">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-success">
            <tr>
                <th>Imagen</th><th>Código</th><th>Nombre</th><th>Contenido</th><th>Unidad</th><th>Categoría</th>
                <th>Marca</th><th>Precio</th><th>Stock</th><th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td><img src="/Images/Productos/@p.prod_imagen" alt="@p.prod_nombre" class="img-producto" /></td>
                <td>@p.prod_codigo</td>
                <td>@p.prod_nombre</td>
                <td>@p.prod_contenido</td>
                <td>@p.prod_unidad?.uni_abreviatura</td>
                <td><span class="badge rounded-pill cat-@(p.prod_categoria?.cat_id % 6)">@p.prod_categoria?.cat_nombre</span></td>
                <td>@p.prod_marca?.mar_nombre</td>
                <td>@p.prod_precio.ToString("C")</td>
                <td>@p.prod_stock.ToString("0.##")</td>
                <td>
                    <span class="badge rounded-pill @(p.prod_activo?.act_nombre == "Inactivo" ? "text-bg-danger" : "text-bg-success")">
                        @p.prod_activo?.act_nombre
                    </span>
                </td>
               <td>
                    <button type="button" class="btn btn-naranja" onclick="abrirModificar(@p.prod_id)">
                        <span class="btn-modificar-icono"><i class="bi bi-pencil-fill"></i></span>
                        Modificar
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalProducto" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white justify-content-center">
                <h5 class="modal-title">Agregar producto</h5>
            </div>
            @await Html.PartialAsync("Agregar", new Inventario.Models.Producto())
        </div>
    </div>
</div>

<div class="modal fade" id="ModificarProducto" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white justify-content-center">
                <h5 class="modal-title">Actualizar producto</h5>
            </div>
            <div id="contenidoModificar"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function abrirModificar(id) {
        const r = await fetch('@Url.Action("Modificar", "Producto")?id=' + id);
        document.getElementById('contenidoModificar').innerHTML = await r.text();
        new bootstrap.Modal(document.getElementById('ModificarProducto')).show();
    }

    function previsualizar(input) {
        if (input.files[0])
            document.getElementById('vistaPreviaEdit').src = URL.createObjectURL(input.files[0]);
    }

    setTimeout(() => document.querySelectorAll('.alert').forEach(a =>
    bootstrap.Alert.getOrCreateInstance(a).close()), 4000);
</script>
}