@model List<Inventario.Models.Compra>

@{
    ViewData["Title"] = "Historial de compras";
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
    </div>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Panel", "Home")" class="text-success text-decoration-none">
                <i class="bi bi-house-fill me-1"></i>Inicio
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Historial de compras</li>
    </ol>
</nav>

<div class="d-flex align-items-center gap-3 mb-4">
    <i class="bi bi-cart-fill text-success" style="font-size: 2.5rem;"></i>
    <div>
        <h1 class="fw-bold mb-0">Historial de Compras</h1>
        <p class="text-muted mb-0">Consulta y da seguimiento a las compras registradas a tus proveedores.</p>
    </div>
</div>

@using (Html.BeginForm("Historial", "Compras", FormMethod.Get, new { @class = "card card-body mb-4" }))
{
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <div class="input-group">
                @Html.TextBox("buscar", (string?)ViewBag.Buscar, new { @class = "form-control", placeholder = "Buscar por folio..." })
                <button class="btn btn-success"><i class="bi bi-search me-1"></i>Buscar</button>
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label text-dark fw-semibold">Sucursal</label>
            @Html.DropDownList("sucursal", (SelectList)ViewBag.Sucursal, "Todas", new { @class = "form-select", onchange = "this.form.submit()" })
        </div>
        <div class="col-md-2">
            <label class="form-label text-dark fw-semibold">Proveedor</label>
            @Html.DropDownList("proveedor", (SelectList)ViewBag.Proveedor, "Todos", new { @class = "form-select", onchange = "this.form.submit()" })
        </div>
        <div class="col-md-2">
            <label class="form-label text-dark fw-semibold">Usuario</label>
            @Html.DropDownList("usuario", (SelectList)ViewBag.Usuario, "Todos", new { @class = "form-select", onchange = "this.form.submit()" })
        </div>
    </div>
}

<div class="card">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-success">
            <tr>
                <th>Folio</th>
                <th>Fecha</th>
                <th>Total</th>
                <th>Proveedor</th>
                <th>Sucursal</th>
                <th>Usuario</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="fw-semibold">@c.com_folio</td>
                    <td>@(c.com_fechaRecepcion == DateTime.MinValue ? "—" : c.com_fechaRecepcion.ToString("dd/MM/yyyy"))</td>
                    <td>@c.com_total.ToString("C")</td>
                    <td>@c.com_proveedor?.pro_nombre</td>
                    <td>@c.com_sucursal?.suc_nombre</td>
                    <td>@c.com_usuario?.usu_username</td>
                    <td>
                        <a class="btn btn-outline-success btn-sm" href="@Url.Action("Detalle", "Compras", new { id = c.com_id })">
                            <i class="bi bi-eye-fill me-1"></i>Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="p-3 small text-muted">Mostrando @Model.Count compras</div>
</div>

@section Scripts {
<script>
    setTimeout(() => document.querySelectorAll('.alert').forEach(a =>
        bootstrap.Alert.getOrCreateInstance(a).close()), 4000);
</script>
}