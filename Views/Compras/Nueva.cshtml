@model List<Inventario.Models.Producto>

@{
    ViewData["Title"] = "Compras";
    var imagenes = Model.ToDictionary(p => p.prod_id, p => p.prod_imagen);
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
    </div>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Panel", "Home")" class="text-success text-decoration-none">
                <i class="bi bi-house-fill me-1"></i>Inicio
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Compras</li>
    </ol>
</nav>

<div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-success">
    <i class="bi bi-cart-fill text-success" style="font-size: 2.5rem;"></i>
    <div>
        <h1 class="fw-bold mb-0 titulo-catalogo">Compras</h1>
        <p class="text-muted mb-0">Registra los tickets de compra de productos.</p>
    </div>
</div>

@using (Html.BeginForm("Guardar", "Compra", FormMethod.Post, new { id = "formCompra" }))
{
    <div class="card panel-verde mb-3">
        <div class="panel-verde-header">
            <span class="fw-bold"><i class="bi bi-card-checklist me-2"></i>Datos de la compra</span>
        </div>
        <div class="p-3">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label text-dark fw-semibold">Proveedor *</label>
                    @Html.DropDownList("proveedor", (SelectList)ViewBag.Proveedores, "Selecciona un proveedor...", new { @class = "form-select", required = "required" })
                </div>
                <div class="col-md-3">
                    <label class="form-label text-dark fw-semibold">Fecha de compra *</label>
                    @Html.TextBox("fecha", DateTime.Today.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date", required = "required" })
                </div>
                <div class="col-md-3">
                    <label class="form-label text-dark fw-semibold">Folio / Ticket *</label>
                    @Html.TextBox("folio", "", new { @class = "form-control", placeholder = "Ej. TCK-001245", required = "required" })
                </div>
                <div class="col-md-3">
                    <label class="form-label text-dark fw-semibold">Usuario</label>
                    <input type="text" class="form-control" value="@User.Identity?.Name" disabled />
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-9">
            <div class="card panel-verde">
                <div class="panel-verde-header">
                    <span class="fw-bold"><i class="bi bi-box-seam me-2"></i>Productos del ticket</span>
                </div>
                <div class="p-3">
                    <div class="row g-2 mb-3">
                        <div class="col">
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Buscar producto..." readonly
                                       style="cursor:pointer" data-bs-toggle="modal" data-bs-target="#modalSeleccionar" />
                            </div>
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-verde" data-bs-toggle="modal" data-bs-target="#modalSeleccionar">
                                <i class="bi bi-plus-lg me-1"></i>Agregar producto
                            </button>
                        </div>
                    </div>

                    <table class="table align-middle mb-0">
                        <thead class="table-success">
                            <tr>
                                <th>Imagen</th><th>Producto</th><th>Cantidad</th>
                                <th>Costo unitario</th><th>Subtotal</th><th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="filas"></tbody>
                    </table>
                    <p id="sinProductos" class="text-center text-muted my-4">Aún no has agregado productos.</p>

                    <div class="d-flex justify-content-end align-items-center gap-3 pt-3 border-top">
                        <span class="fw-bold fs-5">Total:</span>
                        <span id="total" class="fw-bold fs-3 verde">$0.00</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3">
            <div class="card resumen-compra p-3">
                <h6 class="fw-bold text-success mb-3"><i class="bi bi-info-circle-fill me-2"></i>Resumen</h6>
                <dl class="row small mb-3">
                    <dt class="col-5">Folio:</dt><dd class="col-7 fw-semibold" id="resFolio">—</dd>
                    <dt class="col-5">Fecha:</dt><dd class="col-7 fw-semibold" id="resFecha">—</dd>
                    <dt class="col-5">Proveedor:</dt><dd class="col-7 fw-semibold" id="resProveedor">—</dd>
                    <dt class="col-5">Usuario:</dt><dd class="col-7 fw-semibold">@User.Identity?.Name</dd>
                </dl>
                <button type="submit" class="btn btn-verde w-100">
                    <i class="bi bi-floppy me-1"></i>Guardar compra
                </button>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="modalSeleccionar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-md">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-box-seam me-2"></i>Seleccionar producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            @await Html.PartialAsync("SeleccionarProducto", Model)
        </div>
    </div>
</div>

@section Scripts {
<script>
    const imagenes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(imagenes));
    const tbody = document.getElementById('filas');
    const dinero = n => '$' + n.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    function elegirProducto(boton) {
        const id = boton.dataset.id;
        const existente = tbody.querySelector('tr[data-id="' + id + '"]');
        if (existente) {
            const c = existente.querySelector('.cantidad');
            c.value = (parseFloat(c.value) || 0) + 1;
            recalcular();
            return;
        }

        const foto = imagenes[id]
            ? '<img src="/Images/Productos/' + imagenes[id] + '" class="img-producto" alt="" />'
            : '<i class="bi bi-image text-secondary fs-4"></i>';

        const tr = document.createElement('tr');
        tr.dataset.id = id;
        tr.innerHTML =
            '<td>' + foto + '</td>' +
            '<td class="nombre"></td>' +
            '<td><input type="hidden" name="productoId" value="' + id + '" />' +
            '<input type="number" name="cantidad" class="form-control text-center cantidad" value="1" min="0.01" step="0.01" required /></td>' +
            '<td><input type="number" name="costo" class="form-control text-center costo" value="0" min="0" step="0.01" required /></td>' +
            '<td class="subtotal">$0.00</td>' +
            '<td><button type="button" class="btn btn-danger btn-sm quitar"><i class="bi bi-trash-fill"></i></button></td>';
        tr.querySelector('.nombre').textContent = boton.dataset.nombre;
        tbody.appendChild(tr);
        recalcular();
    }

    function recalcular() {
        let total = 0;
        tbody.querySelectorAll('tr').forEach(tr => {
            const sub = (parseFloat(tr.querySelector('.cantidad').value) || 0) * (parseFloat(tr.querySelector('.costo').value) || 0);
            tr.querySelector('.subtotal').textContent = dinero(sub);
            total += sub;
        });
        document.getElementById('total').textContent = dinero(total);
        document.getElementById('sinProductos').classList.toggle('d-none', tbody.children.length > 0);
    }

    function actualizarResumen() {
        const prov = document.getElementById('proveedor');
        const fecha = document.getElementById('fecha').value.split('-').reverse().join('/');
        document.getElementById('resFolio').textContent = document.getElementById('folio').value || '—';
        document.getElementById('resFecha').textContent = fecha || '—';
        document.getElementById('resProveedor').textContent = prov.value ? prov.options[prov.selectedIndex].text : '—';
    }

    tbody.addEventListener('input', recalcular);
    tbody.addEventListener('click', e => {
        if (e.target.closest('.quitar')) {
            e.target.closest('tr').remove();
            recalcular();
        }
    });
    ['proveedor', 'fecha', 'folio'].forEach(id =>
        document.getElementById(id).addEventListener('input', actualizarResumen));

    document.getElementById('formCompra').addEventListener('submit', e => {
        if (!tbody.children.length) {
            e.preventDefault();
            document.getElementById('sinProductos').classList.add('text-danger');
        }
    });

    actualizarResumen();
</script>
}