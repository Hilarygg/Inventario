@{
    ViewData["Title"] = "Nosotros";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Sobre nosotros</h1>
        <p class="text-muted">[Frase corta que describa tu negocio]</p>
    </div>

    <div class="row justify-content-center text-center mb-5">
        <div class="col-md-8">
            <i class="bi bi-shop display-1 text-primary"></i>
            <h3 class="mt-3">Quiénes somos</h3>
            <p>
                [Nombre del negocio] es un supermercado dedicado a ofrecer
                productos de calidad a buenos precios. Desde [año] atendemos
                a nuestra comunidad con un servicio cercano y confiable.
            </p>
        </div>
    </div>

    <div class="row text-center g-4">
        <div class="col-md-4">
            <i class="bi bi-bullseye fs-1 text-primary"></i>
            <h5 class="mt-2">Misión</h5>
            <p>[Qué hace tu negocio y para quién]</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-eye fs-1 text-primary"></i>
            <h5 class="mt-2">Visión</h5>
            <p>[A dónde quieres llegar]</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-heart fs-1 text-primary"></i>
            <h5 class="mt-2">Valores</h5>
            <p>[Honestidad, calidad, buen servicio]</p>
        </div>
    </div>
</div>