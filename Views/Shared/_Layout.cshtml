
@{
    Layout = null;
    string titulo = ViewData["Title"]?.ToString() ?? "Inicio";
    bool esAdmin = User.FindFirst("RolId")?.Value == "1";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@titulo - SuperCampestre</title>

    <link rel="stylesheet" href="@Url.Content("~/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Inventario.styles.css")" />

    @await RenderSectionAsync("Styles", required: false)
</head>

    <body class="d-flex flex-column min-vh-100 bg-light">

        @if (esAdmin)
    {
        <partial name="_LayoutAdmin" />
            <div class="d-flex flex-grow-1">
                @await Component.InvokeAsync("Menu", new { vista = "Sidebar" })
                <main class="flex-grow-1 p-4">@RenderBody()</main>
            </div>
    }
    else
    {
        <header class="sticky-top">
            <nav class="navbar navbar-expand-lg navbar-dark navbar-orange">
                <div class="container-fluid">

                    <a class="navbar-brand fw-semibold ms-5" href="@Url.Action("Index", "Home")">
                        🛒 <span class="text-dark">Super</span><span class="text-white">Campestre</span>
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNav"
                            aria-controls="mainNav"
                            aria-expanded="false"
                            aria-label="Mostrar u ocultar navegación">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">

                        @await Component.InvokeAsync("Menu")

                        <ul class="navbar-nav menu-centrado">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                    href="#"
                                    role="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                        <i class="bi bi-person-circle me-1"></i>
                                        @User.Identity.Name
                                    </a>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            @Html.ActionLink(
                                                "Mi perfil",
                                                "Perfil",
                                                "Cuenta",
                                                null,
                                                new { @class = "dropdown-item" }
                                            )
                                        </li>

                                        <li><hr class="dropdown-divider" /></li>

                                        <li>
                                            @using (Html.BeginForm("Logout", "Login", FormMethod.Post))
                                            {
                                                <button type="submit" class="dropdown-item">
                                                    Cerrar sesión
                                                </button>
                                            }
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Login")">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
                                    </a>
                                </li>
                            }
                        </ul>

                    </div>
                </div>
            </nav>
        </header>

        <main role="main" class="container-fluid flex-grow-1 py-4 px-4">
            @RenderBody()
        </main>

    }


    <footer class="footer-verde text-white mt-auto">
        <div class="container-fluid px-5 py-2">
            <div class="row row-cols-2 row-cols-md-4 g-3 text-start">

                <div class="col d-flex align-items-center">
                    <a href="@Url.Action("Index", "Home")"
                       class="navbar-brand fw-semibold ms-5">
                        <i class="bi bi-shop me-2"></i>
                        <span class="text-white">SuperCampestre</span>
                    </a>
                </div>

                <div class="col d-flex align-items-center gap-3">
                    <i class="bi bi-geo-alt fs-3"></i>
                    <div>
                        <strong class="small">Ubicación</strong>
                        <br />
                        <span class="small opacity-75">
                            Calle Principal #123, Celaya
                        </span>
                    </div>
                </div>

                <div class="col d-flex align-items-center gap-3">
                    <i class="bi bi-clock fs-3"></i>
                    <div>
                        <strong class="small">Horario</strong>
                        <br />
                        <span class="small opacity-75">
                            Lun a sáb, 8:00 - 21:00
                        </span>
                    </div>
                </div>

                <div class="col d-flex align-items-center gap-3">
                    <span class="small opacity-75">
                        @DateTime.Now.Year SuperCampestre.
                        Todos los derechos reservados.
                    </span>
                </div>

            </div>
        </div>
    </footer>

    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/js/site.js")"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
