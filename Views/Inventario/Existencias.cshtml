@model List<Inventario.Models.Inventarios>

@{
    int total = ViewBag.Total ?? 0;
    int conStock = ViewBag.ConStock ?? 0;
    int stockBajo = ViewBag.StockBajo ?? 0;
    int sinExistencias = ViewBag.SinExistencias ?? 0;
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
    </div>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Panel", "Home")" class="text-success text-decoration-none">
                <i class="bi bi-house-fill me-1"></i>Inicio
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Inventario</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-success">
    <div class="d-flex align-items-center gap-3">
        <img src="/Images/cubo_verde.png" alt="Productos" style="height:60px" />
        <div>
            <h1 class="fw-bold mb-0">Existencias</h1>
            <p class="text-muted mb-0">Consulta y administra las existencias de productos en cada sucursal.</p>
        </div>
    </div>
     @using (Html.BeginForm("Crear", "Inventario", FormMethod.Get, new { @class = "m-0" }))
    {
        <button type="button" class="btn-agregar" data-bs-toggle="modal" data-bs-target="#modalInventario">
            <span class="btn-agregar-icono"><i class="bi bi-plus-lg"></i></span>
            Agregar Inventario
        </button>
    }
</div>

<div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
    <div class="col">
        <div class="tarjeta-resumen resumen-verde">
            <i class="bi bi-box-seam-fill icono"></i>
            <div>
                <div class="numero">@total.ToString("N0")</div>
                <div class="etiqueta">Productos en total</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="tarjeta-resumen resumen-azul">
            <i class="bi bi-check-circle-fill icono"></i>
            <div>
                <div class="numero">@conStock.ToString("N0")</div>
                <div class="etiqueta">Con stock</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="tarjeta-resumen resumen-naranja">
            <i class="bi bi-exclamation-circle-fill icono"></i>
            <div>
                <div class="numero">@stockBajo.ToString("N0")</div>
                <div class="etiqueta">Stock bajo</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="tarjeta-resumen resumen-morado">
            <i class="bi bi-box2-fill icono"></i>
            <div>
                <div class="numero">@sinExistencias.ToString("N0")</div>
                <div class="etiqueta">Sin existencias</div>
            </div>
        </div>
    </div>
</div>

@using (Html.BeginForm("Existencias", "Inventario", FormMethod.Get, new { @class = "card card-body mb-4" }))
{
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <div class="input-group">
                @Html.TextBox("buscar", (string)ViewBag.Buscar, new { @class = "form-control", placeholder = "Buscar por nombre, código o marca..." })
                <button class="btn btn-success"><i class="bi bi-search me-1"></i>Buscar</button>
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label text-dark fw-semibold">Categoría</label>
            @Html.DropDownList("categoria", (SelectList)ViewBag.Categorias, "Todas", new { @class = "form-select", onchange = "this.form.submit()" })
        </div>
        <div class="col-md-2">
            <label class="form-label form-label text-dark fw-semibold">Marca</label>
            @Html.DropDownList("marca", (SelectList)ViewBag.Marcas, "Todas", new { @class = "form-select", onchange = "this.form.submit()" })
        </div>
        <div class="col-md-2">
            <label class="form-label form-label text-dark fw-semibold">Estado</label>
            @Html.DropDownList("estado", (SelectList)ViewBag.Estados, "Todos", new { @class = "form-select", onchange = "this.form.submit()" })
        </div>
    </div>
}

<div class="card panel-verde">
    <div class="panel-verde-header">
        <span class="fw-bold fs-5"><i class="bi bi-box-seam-fill me-2"></i>Lista de productos</span>
    </div>
    <table class="table table-hover align-middle mb-0">
        <thead class="table-success">
            <tr>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Sucursal</th>
                <th>Stock actual</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                var clase = i.Estado == "Disponible" ? "estado-disponible"
                          : i.Estado == "Stock bajo" ? "estado-bajo" : "estado-sin";
                <tr>
                    <td class="text-start">
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(i.inv_producto?.prod_imagen))
                            {
                                <img src="/Images/Productos/@i.inv_producto.prod_imagen" alt="" class="img-producto" />
                            }
                            <span>@i.inv_producto?.prod_nombre</span>
                        </div>
                    </td>
                    <td>@i.inv_producto?.prod_categoria?.cat_nombre</td>
                    <td>@i.inv_sucursal?.suc_nombre</td>
                    <td>@i.inv_cantidad.ToString("0.##")</td>
                    <td><span class="badge rounded-pill @clase">@i.Estado</span></td>
                    <td>
                        <button type="button" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-eye-fill me-1"></i>Ver detalle
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="p-3 small text-muted">Mostrando @Model.Count registros</div>
</div>

<div class="modal fade" id="modalInventario" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white justify-content-center">
                <h5 class="modal-title">Agregar Inventario</h5>
            </div>
            @await Html.PartialAsync("AgregarInventario", new Inventario.Models.Inventarios())
        </div>
    </div>
</div>

<div class="modal fade" id="modalSeleccionar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-md">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-box-seam me-2"></i>Seleccionar producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            @await Html.PartialAsync("SeleccionarProducto", (List<Inventario.Models.Producto>)ViewBag.Productos)
        </div>
    </div>
</div>

<script>
    function abrirSelector() {
    const modalInv = document.getElementById('modalInventario');
    modalInv.addEventListener('hidden.bs.modal', () => {
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalSeleccionar')).show();
    }, { once: true });
    bootstrap.Modal.getOrCreateInstance(modalInv).hide();
    }

    document.getElementById('modalSeleccionar').addEventListener('hidden.bs.modal', () => {
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalInventario')).show();
    });

    function elegirProducto(boton) {
        document.getElementById('inv_producto_prod_id').value = boton.dataset.id;
        document.getElementById('inv_producto_prod_nombre').value = boton.dataset.nombre;
    }
</script>